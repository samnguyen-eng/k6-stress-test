# source .env trước khi chạy:  source .env
# Hoặc dùng trực tiếp: ./run-seed.sh  ./run-stress-1500.sh

export PROJECT_ID=parking-system-497603
export BASE_URL=https://parking-api-763182684658.asia-southeast1.run.app

export PASSWORD=Test@123456
export USER_COUNT=1000
export DEPOSIT_AMOUNT=1000
